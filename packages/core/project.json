{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "targets": {
    "build": {
      "cache": true,
      "command": "bun run --cwd packages/core build",
      "outputs": ["{projectRoot}/dist"]
    },
    "typecheck": {
      "cache": true,
      "command": "bun run --cwd packages/core typecheck"
    }
  }
}
