{
  "name": "@bead/core",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build ./src/colors.ts ./src/canvas-sizes.ts ./src/canvas-snapshot.ts ./src/bead-image-svg.ts ./src/discover.ts --outdir ./dist --format esm --target node --packages external",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "exports": {
    "./colors": {
      "types": "./src/colors.ts",
      "bun": "./src/colors.ts",
      "node": "./dist/colors.js",
      "default": "./src/colors.ts"
    },
    "./discover": {
      "types": "./src/discover.ts",
      "bun": "./src/discover.ts",
      "node": "./dist/discover.js",
      "default": "./src/discover.ts"
    },
    "./canvas-sizes": {
      "types": "./src/canvas-sizes.ts",
      "bun": "./src/canvas-sizes.ts",
      "node": "./dist/canvas-sizes.js",
      "default": "./src/canvas-sizes.ts"
    },
    "./canvas-snapshot": {
      "types": "./src/canvas-snapshot.ts",
      "bun": "./src/canvas-snapshot.ts",
      "node": "./dist/canvas-snapshot.js",
      "default": "./src/canvas-snapshot.ts"
    },
    "./bead-image-svg": {
      "types": "./src/bead-image-svg.ts",
      "bun": "./src/bead-image-svg.ts",
      "node": "./dist/bead-image-svg.js",
      "default": "./src/bead-image-svg.ts"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5"
  }
}
