# Shared app URLs
VITE_API_URL=http://localhost:3000

# API server
# Comma-separated origins allowed to call the API.
PORT=3000
CORS_ORIGINS=http://localhost:5173,https://localhost

# Inngest (durable AI workflows)
# Local API dev commands enable Inngest Dev Mode automatically; run
# `bun run dev:inngest` to start the local Dev Server. Event and signing keys
# are not required locally. The Vercel integration injects them for Preview
# and Production; configure them manually when deploying to other platforms.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI image stylization. Set AI_IMAGE_PROVIDER to openai (default) or qwen.
AI_IMAGE_PROVIDER=openai
# OpenAI is required only when AI_IMAGE_PROVIDER=openai.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2
# Qwen is required only when AI_IMAGE_PROVIDER=qwen. QWEN_BASE_URL is the
# MaaS Workspace API root, for example https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1.
QWEN_API_KEY=
QWEN_BASE_URL=
# QWEN_IMAGE_MODEL=qwen-image-3.0-pro

# Docker Compose PostgreSQL
POSTGRES_DB=bead
POSTGRES_USER=bead
POSTGRES_PASSWORD=bead
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}

# Docker Compose MinIO (local S3-compatible object storage)
MINIO_ROOT_USER=bead
MINIO_ROOT_PASSWORD=beadbead
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
S3_ENDPOINT=http://localhost:${MINIO_API_PORT}
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_BUCKET=bead
S3_REGION=auto

# Client analytics
# Optional. Set both values to enable Umami analytics.
# VITE_UMAMI_SCRIPT_URL=https://analytics.example.com/script.js
# VITE_UMAMI_WEBSITE_ID=

# Marketing site links
# Required when building the marketing site.
# Replace app store URLs when Android/iOS builds are published.
VITE_SITE_GITHUB_URL=
VITE_SITE_WEB_APP_URL=http://localhost:5173/
VITE_SITE_ANDROID_URL=
VITE_SITE_IOS_URL=
